{
	"info": {
		"_postman_id": "api-praktikum-collection-v1",
		"name": "API Praktikum & Rental PS",
		"description": "Postman collection untuk API Master Asset, Master Mahasiswa, Rental PlayStation (Unit & Transaksi), Master Produk, dan Transaksi Peminjaman.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://api.melangkah.my.id",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Rental PS - Master Unit",	
			"item": [
				{
					"name": "Read All Unit PS",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/unit/read.php",
							"host": ["{{base_url}}"],
							"path": ["unit", "read.php"]
						}
					}
				},
				{
					"name": "Detail Unit PS",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/unit/detail.php?id=1",
							"host": ["{{base_url}}"],
							"path": ["unit", "detail.php"],
							"query": [
								{
									"key": "id",
									"value": "1"
								}
							]
						}
					}
				},
				{
					"name": "Create Unit PS",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nama_unit\": \"PS5 - Room VIP 2\",\n  \"tipe_ps\": \"PS5\",\n  \"harga_per_jam\": 25000,\n  \"status\": \"Tersedia\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/unit/create.php",
							"host": ["{{base_url}}"],
							"path": ["unit", "create.php"]
						}
					}
				},
				{
					"name": "Update Unit PS",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id_unit\": 1,\n  \"nama_unit\": \"PS5 - Room VIP 1 (Updated)\",\n  \"tipe_ps\": \"PS5\",\n  \"harga_per_jam\": 22000,\n  \"status\": \"Tersedia\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/unit/update.php",
							"host": ["{{base_url}}"],
							"path": ["unit", "update.php"]
						}
					}
				},
				{
					"name": "Delete Unit PS",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id_unit\": 4\n}"
						},
						"url": {
							"raw": "{{base_url}}/unit/delete.php?id=4",
							"host": ["{{base_url}}"],
							"path": ["unit", "delete.php"],
							"query": [
								{
									"key": "id",
									"value": "4"
								}
							]
						}
					}
				}
			]
		},
